# Supabase project (Project Settings → API in the Supabase dashboard).
# Required — bookings, availability, the gallery and the admin panel all
# depend on Supabase (see supabase/*.sql for the migrations to run).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) — sends the booking notification email to the business
# and the automatic confirmation email to the customer.
# Without RESEND_API_KEY, bookings are still saved normally — emails are
# just skipped and a warning is logged.
RESEND_API_KEY=your-resend-api-key
# Mailbox that receives new booking notifications.
BOOKING_NOTIFICATION_EMAIL=info@momopolis.ch
# Optional — the "from" address for both emails. Must be on a domain you've
# verified in Resend; defaults to Resend's shared testing address, which can
# only deliver to your own Resend account email until you verify a domain.
RESEND_FROM_EMAIL="Momopolis <no-reply@momopolis.ch>"

# Admin panel (/admin) — manage bookings, availability, the gallery and site
# photos without touching the code. Requires Supabase to be configured above.
# ADMIN_USERNAME: the username used to log in at /admin/login.
# ADMIN_PASSWORD: the password used to log in at /admin/login.
# ADMIN_SESSION_SECRET: a random secret used to sign the login session —
# generate one with `openssl rand -hex 32`, keep it private, never reuse it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-with-openssl-rand--hex-32
